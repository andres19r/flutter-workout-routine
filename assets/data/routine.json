          {
            "name": "Movilidad de hombros/escápula (círculos, dislocates con toalla)",
            "sets": "1",
            "reps": "20"
          },
          {
            "name": "Scapular pulls colgado en la barra",
            "sets": "2",
            "reps": "8"
          },
          {
            "name": "Dead hang",
            "sets": "2",
            "reps": "20-30s"
          },
          {
            "name": "1 serie ligera de australianas en anillas",
            "sets": "1",
            "reps": "10"
          }
        ],
        "restBeforeRoutine": "1 min"
      },
      "blocks": [
        {
          "name": "Fuerza vertical: Dominadas pronas",
          "type": "fuerza",
          "restBetweenSets": "2-2.5 min",
          "note": "Rango completo, sin balanceo, bajada controlada (~2s). Base actual: 3 dominadas pronas máx.",
          "progression": "5×3 limpias a RIR 1 → retest → 4×4…",
          "exercises": [
            {
              "name": "Dominadas pronas",
              "sets": "5",
              "reps": "2",
              "intensity": "RIR 1"
            },
            {
              "name": "Negativas lentas",
              "sets": "3",
              "reps": "1",
              "note": "Subes con impulso, bajas en 4-5s controlando. Descanso ~90s."
            }
          ]
        },
        {
          "name": "Hipertrofia vertical: Chin-ups",
          "type": "hipertrofia",
          "restBetweenSets": "90-120s",
          "note": "Reps las que salgan dejando 1 en el tanque (probablemente 3-4, y está perfecto).",
          "progression": "Hasta 3×6 limpias, luego progresamos.",
          "exercises": [
            {
              "name": "Chin-ups (supinas)",
              "sets": "3",
              "reps": "las que salgan",
              "intensity": "RIR 1"
            }
          ]
        },
        {
          "name": "Hipertrofia horizontal: Australianas en anillas",
          "type": "hipertrofia",
          "restBetweenSets": "90s",
          "note": "Regula la dificultad caminando los pies: empieza donde te queden 1-2 reps en reserva.",
          "progression": "Subir reps → caminar pies adelante → pies elevados en silla.",
          "exercises": [
            {
              "name": "Australianas en anillas",
              "sets": "4",
              "reps": "8-12",
              "intensity": "tempo 2-1-2"
            }
          ]
        },
        {
          "name": "Deltoides posterior / trapecio: Face-pull en anillas",
          "type": "accesorios",
          "restBetweenSets": "60-90s",
          "note": "Codos altos y abiertos, jalas hacia la cara/clavícula.",
          "exercises": [
            { "name": "Face-pull en anillas", "sets": "2-3", "reps": "12-15" }
          ]
        },
        {
          "name": "Accesorios + core",
          "type": "core",
          "restBetweenSets": "60-90s",
          "exercises": [
            {
              "name": "Australianas supinas en anillas (bíceps)",
              "sets": "2",
              "reps": "10-15"
            },
            {
              "name": "Hanging knee raises",
              "sets": "3",
              "reps": "8-12",
              "note": "Colgado, rodillas al pecho sin balanceo. Semilla del L-sit."
            },
            { "name": "Dead hang al máximo", "sets": "2", "reps": "máx" }
          ]
        }
      ]
    },

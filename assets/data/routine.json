{
  "meta": {
    "goals": "fuerza e hipertrofia",
    "frequency": "6 días/semana — Push/Pull/Legs ×2 (día A = fuerza, día B = volumen)"
  },
  "days": [
    {
      "id": "push-a",
      "name": "Push A",
      "group": "push",
      "focus": "fuerza",
      "warmup": {
        "duration": "8-10 min",
        "exercises": [
          {
            "name": "Movilidad de hombros, muñecas y codos",
            "sets": "1",
            "reps": "20"
          },
          {
            "name": "Scapular push-ups en plancha",
            "sets": "2",
            "reps": "8"
          },
          {
            "name": "Flexiones inclinadas suaves",
            "sets": "1-2",
            "reps": "10"
          }
        ],
        "restBeforeRoutine": "1 min"
      },
      "blocks": [
        {
          "name": "Potencia: Flexiones con palmada (opcional)",
          "type": "potencia",
          "restBetweenSets": "2 min",
          "note": "Máxima explosión, calidad no cantidad. Frescas, al inicio. Si andas corto de tiempo, este es el primer bloque que se corta.",
          "exercises": [
            {
              "name": "Flexiones con palmada",
              "sets": "4",
              "reps": "5 explosivas"
            }
          ]
        },
        {
          "name": "Fuerza horizontal: Pseudo-planche push-ups",
          "type": "fuerza",
          "restBetweenSets": "2-2.5 min",
          "note": "Manos a la altura de la cintura, cuerpo inclinado hacia adelante. Cuerpo recto y tenso.",
          "progression": "Inclinarte más adelante (manos más abajo) conforme mejoras.",
          "exercises": [
            {
              "name": "Pseudo-planche push-ups",
              "sets": "4-5",
              "reps": "5-8",
              "intensity": "RIR 1-2"
            }
          ]
        },
        {
          "name": "Fuerza/hipertrofia vertical: Dips",
          "type": "fuerza",
          "restBetweenSets": "2 min",
          "note": "Rango completo: hombro por debajo del codo, sube a bloqueo. Los dips son la mitad de tu muscle-up.",
          "progression": "Tempo lento (bajada 3s) → pausa 1s abajo → dips en anillas.",
          "exercises": [
            {
              "name": "Dips",
              "sets": "4",
              "reps": "6-8",
              "intensity": "RIR 1-2"
            }
          ]
        },
        {
          "name": "Empuje vertical / hombros: Pike push-ups",
          "type": "fuerza",
          "restBetweenSets": "90-120s",
          "note": "Pies en la silla, cadera bien alta, cuerpo casi vertical. Empujas como press de hombros.",
          "progression": "Silla más alta → HSPU contra pared → HSPU libre.",
          "exercises": [
            {
              "name": "Pike push-ups (pies elevados)",
              "sets": "3-4",
              "reps": "6-10"
            }
          ]
        },
        {
          "name": "Hipertrofia pecho: Flexiones declinadas",
          "type": "hipertrofia",
          "restBetweenSets": "90s",
          "note": "Pies elevados en silla (pecho superior).",
          "progression": "Subir reps → archer push-ups.",
          "exercises": [
            {
              "name": "Flexiones declinadas",
              "sets": "3",
              "reps": "8-15",
              "intensity": "tempo 2-1-2, RIR 1"
            }
          ]
        },
        {
          "name": "Tríceps + core",
          "type": "core",
          "restBetweenSets": "90s / 60s",
          "exercises": [
            { "name": "Flexiones diamante", "sets": "2-3", "reps": "8-12" },
            {
              "name": "Hollow body hold",
              "sets": "3",
              "reps": "20-30s",
              "note": "Descanso 60s entre series."
            }
          ]
        }
      ]
    },
